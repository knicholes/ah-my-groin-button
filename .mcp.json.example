{
  "_comment": [
    "Copy to .mcp.json and fix the paths for your machine. .mcp.json is",
    "gitignored because it is machine-specific.",
    "",
    "This is a development convenience for driving KiCad from an MCP client.",
    "You do NOT need it to build the device -- the board and case are",
    "generated by kicad/build_v3.py and case/build_v2.py, which take no MCP."
  ],
  "mcpServers": {
    "kicad": {
      "command": "node",
      "args": [
        "<path-to>/KiCAD-MCP-Server/dist/index.js"
      ],
      "env": {
        "KICAD_PYTHON": "<kicad-install>/bin/python.exe",
        "KICAD10_FOOTPRINT_DIR": "<kicad-install>/share/kicad/footprints",
        "KICAD10_SYMBOL_DIR": "<kicad-install>/share/kicad/symbols",
        "LOG_LEVEL": "info",
        "PYTHONPATH": "<kicad-install>/bin/Lib/site-packages;<kicad-user-dir>/3rdparty/Python311/site-packages"
      }
    }
  }
}
