# PlatformIO build artifacts
**/.pio/

# VS Code Local History. These were committed as bare gitlinks (mode 160000)
# with no .gitmodules entry, so every clone got two empty directories and a
# submodule error. Untracked 2026-07-26.
**/.history/

# KiCad lock files and temp exports
**/*.lck
**/~*.kicad_*.lck
kicad/*-temp_view.svg

# Routing intermediates -- regenerated by kicad/route_v3.py from the .kicad_pcb
kicad/*.dsn
kicad/*.ses
kicad/_dsn_export.kicad_pcb

# DRC reports -- regenerated by kicad-cli, not an input to anything
kicad/*.rpt

# Scratch probe scripts and intermediates -- fitcheck_v3.py writes
# kicad/_fitcheck.kicad_pcb (and kicad-cli drops a .kicad_prl beside it)
kicad/_*
__pycache__/
