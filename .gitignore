# PlatformIO build artifacts
v2/firmware/.pio/

# KiCad lock files and temp exports
**/*.lck
**/~*.kicad_*.lck
kicad/*-temp_view.svg

# Routing intermediates -- regenerated by kicad/route_v3.py from the .kicad_pcb
kicad/*.dsn
kicad/*.ses
kicad/_dsn_export.kicad_pcb

# DRC reports -- regenerated by kicad-cli, not an input to anything
kicad/*.rpt

# Scratch probe scripts and bytecode
kicad/_*.py
__pycache__/
